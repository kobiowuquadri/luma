# LUMA API: copy to .env for local runs. Never commit real keys.
# Anything not listed uses the defaults in the code. Every option, including
# limits, voices and timeouts, is described in docs/environment.md.

# Ask LUMA and Explain. Empty = turned off.
OPENAI_API_KEY=

# Spoken questions and spoken answers. Empty = turned off.
YARNGPT_API_KEY=

# Local server (the Android emulator reaches it as http://10.0.2.2:8080).
# On Render, leave both unset: Render sets PORT and the server listens on all interfaces.
PORT=8080
BIND_HOST=127.0.0.1
