{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "LUMA_BUILD_ARCHS": "arm64-v8a,x86_64"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "LUMA_BUILD_ARCHS": "armeabi-v7a,arm64-v8a"
      }
    },
    "emulator": {
      "extends": "preview",
      "env": {
        "LUMA_BUILD_ARCHS": "x86_64"
      }
    },
    "production": {
      "environment": "production",
      "android": {
        "buildType": "app-bundle"
      }
    }
  }
}
